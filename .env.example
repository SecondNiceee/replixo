# ---------------------------------------------------------------------------
# Next.js приложение. Скопировать: cp .env.example .env.local
#
# Переменные с префиксом NEXT_PUBLIC_ попадают в браузерный бандл — секретов в
# них быть не должно. Всё остальное читается только на сервере.
# ---------------------------------------------------------------------------

# Postgres: тот же инстанс, что использует сокет-сервер
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Связь Next → сокет-сервер (сервер к серверу)
# ---------------------------------------------------------------------------

# Общий секрет для маршрутов /internal/* сокет-сервера. Next-роуты дружбы
# (request/accept/decline/cancel/remove) дёргают хук сразу после записи в БД,
# и сокет-сервер рассылает `dm:friends:changed` обоим участникам.
#
# Значение ОБЯЗАНО совпадать с INTERNAL_HOOK_SECRET в server/.env — иначе хук
# вернёт 401, роут отдаст notified: false и включится фолбэк через websocket
# инициатора (работает только когда у него открыто соединение).
#
# Сгенерировать: openssl rand -hex 32
INTERNAL_HOOK_SECRET=

# Приватный адрес сокет-сервера для внутренних запросов. Внутри одного VPS это
# localhost, поэтому трафик с секретом не выходит наружу. Если не задан,
# используется NEXT_PUBLIC_MEDIASOUP_URL, а затем http://localhost:3001.
MEDIASOUP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Публичные переменные (видны в браузере)
# ---------------------------------------------------------------------------

# URL сокет/mediasoup сервера для клиента
NEXT_PUBLIC_MEDIASOUP_URL=http://localhost:3001

# ICE-серверы для WebRTC
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=your_turn_username
NEXT_PUBLIC_TURN_CREDENTIAL=your_turn_credential
