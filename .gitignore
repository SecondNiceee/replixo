# Environment variables.
# Правило `.env*.local` не покрывало ни корневой `.env`, ни `server/.env` — а в
# них лежит INTERNAL_HOOK_SECRET и DATABASE_URL. Игнорируем всё, кроме шаблонов
# `*.example`, которые в git нужны.
.env
.env.*
!.env.example
!.env.*.example

# Common ignores
node_modules
.next/
.DS_Store

# TypeScript incremental build cache (machine-local, never commit)
*.tsbuildinfo

# Electron build output
release/

# CMake артефакты нативного helper'а (сам .exe уже покрыт правилом *.exe ниже)
electron/native/process-loopback/build/
electron/native/process-loopback/bin/

# Uploaded chat attachments (live on the server disk, not in git)
server/uploads/
uploads/

# Large app installers (~900MB, kept on the server disk, NOT in git)
server/downloads/
downloads/
*.exe
