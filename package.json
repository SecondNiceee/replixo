    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "mediasoup": "^3.20.3",
    "mediasoup-client": "^3.20.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.12.4",
    "shadcn": "^4.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "tldraw": "^2.4.4",
    "tw-animate-css": "^1.4.0",
    "uiohook-napi": "^1.5.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
