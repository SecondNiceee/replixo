{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "mediasoup": "cd server && pnpm install && pnpm run build && pnpm start",
    "mediasoup:dev": "cd server && pnpm install && pnpm run dev",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "electron": "electron .",
    "build:native": "node scripts/build-native-helper.mjs",
    "check:native": "node scripts/check-native-helper.mjs --pre",
    "dist": "node scripts/check-native-helper.mjs --pre && electron-builder --win --config electron-builder.yml && node scripts/check-native-helper.mjs --post",
    "dist:dir": "node scripts/check-native-helper.mjs --pre && electron-builder --win --dir --config electron-builder.yml && node scripts/check-native-helper.mjs --post --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
