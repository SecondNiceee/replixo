# Port the mediasoup server listens on
PORT=3001

# The public IP of this server (required for WebRTC ICE)
ANNOUNCED_IP=0.0.0.0

# CORS origin for the Next.js frontend
CLIENT_ORIGIN=http://localhost:3000

# Postgres connection string for chat persistence (same DB as the Next.js app /
# authorization). If omitted, the chat still works but is ephemeral (not saved).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Общий секрет для внутренних маршрутов /internal/* (запросы «Next → этот
# сервер»). Через них Next-роут сообщает об изменении дружбы сразу после записи
# в Postgres, поэтому realtime не зависит от websocket инициатора.
#
# Значение ОБЯЗАНО совпадать с INTERNAL_HOOK_SECRET у Next-приложения.
# Пока переменная не задана, /internal/* отвечает 503, а realtime дружбы
# работает через фолбэк на socket-событии (медленнее и менее надёжно).
#
# Сгенерировать: openssl rand -hex 32
INTERNAL_HOOK_SECRET=

# TURN server credentials
TURN_URL=turn:your.turn.server:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# STUN server (optional, defaults to Google's if not set)
STUN_URL=stun:stun.l.google.com:19302
