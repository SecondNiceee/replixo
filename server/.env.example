# Port the mediasoup server listens on
PORT=3001

# The public IP of this server (required for WebRTC ICE)
ANNOUNCED_IP=0.0.0.0

# CORS origin for the Next.js frontend
CLIENT_ORIGIN=http://localhost:3000

# Postgres connection string for chat persistence (same DB as the Next.js app /
# authorization). If omitted, the chat still works but is ephemeral (not saved).
DATABASE_URL=postgres://user:password@host:5432/dbname

# TURN server credentials
TURN_URL=turn:your.turn.server:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# STUN server (optional, defaults to Google's if not set)
STUN_URL=stun:stun.l.google.com:19302
